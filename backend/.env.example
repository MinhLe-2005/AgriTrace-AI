SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# --- Option A: Supabase Cloud PostgreSQL ---
# DB_HOST=aws-0-ap-south-1.pooler.supabase.com
# DB_PORT=5432
# POSTGRES_DB=postgres
# POSTGRES_USER=postgres.your_project_id
# POSTGRES_PASSWORD=your_password
# SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require

# --- Option B: Local PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
POSTGRES_DB=my_fullstack_app
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/my_fullstack_app

# --- Security & JWT ---
# Use at least 32 random characters (for example: `openssl rand -base64 32`).
JWT_SECRET=dev-secret-key-must-be-at-least-32-characters-long-123456
JWT_EXPIRATION=3600
REFRESH_TOKEN_EXPIRATION=604800
CORS_ALLOWED_ORIGINS=http://localhost:3000

BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrator
